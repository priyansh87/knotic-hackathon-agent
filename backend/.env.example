# Server port
PORT=5000

# Agora Credentials (Get these from Console.agora.io)
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
AGORA_CUSTOMER_ID=your_agora_customer_id
AGORA_CUSTOMER_SECRET=your_agora_customer_secret

# Groq Cloud (API Key from console.groq.com)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-specdec

# Public Ngrok / LocalTunnel URL (Must be HTTPS)
# Agora Cloud calls this URL to access your custom LLM proxy endpoint
PUBLIC_TUNNEL_URL=https://xxxx.ngrok-free.app

# GitHub Integration (Optional - falls back to local mocks if empty)
GITHUB_TOKEN=your_github_pat_token
GITHUB_REPO=owner/repo

# Slack Webhook Escalation (Optional - falls back to local mocks if empty)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxxx
